@page "/"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="text-center">
        <div class="float-animation" style="display: inline-block;">
            <div style="width: 100px; height: 100px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                <i class="bi bi-currency-exchange" style="font-size: 50px; color: white;"></i>
            </div>
        </div>
        
        <h1 class="gradient-text" style="font-size: 3.5rem; font-weight: 800; margin-bottom: 20px;">
            Welcome to FXTransfer
        </h1>
        
        <p class="lead text-white-50 mb-5" style="font-size: 1.2rem;">
            Fast, secure, and affordable international money transfers
        </p>
        
        @if (_isLoggedIn)
        {
            <!-- Content for Logged In Users -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="glass-card p-4">
                        <h4 class="gradient-text">Welcome back, @_userName!</h4>
                        <p class="text-white-50 mb-3">Ready to make a transfer?</p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="/exchange" class="btn-neon">Send Money Now</a>
                            <a href="/dashboard" class="btn-glass">Go to Dashboard</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Content for Guest Users -->
            <div class="row mt-4">
                <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="glass-card stat-card p-4 text-center">
                        <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #00d2ff, #3a7bd5); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                            <i class="bi bi-graph-up" style="font-size: 35px; color: white;"></i>
                        </div>
                        <h5 class="gradient-text mt-3" style="font-weight: 700;">Best Exchange Rates</h5>
                        <p class="text-white-50">Get real-time exchange rates from top financial markets</p>
                    </div>
                </div>
        
                <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="glass-card stat-card p-4 text-center">
                        <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #f093fb, #f5576c); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                            <i class="bi bi-shield-check" style="font-size: 35px; color: white;"></i>
                        </div>
                        <h5 class="gradient-text mt-3" style="font-weight: 700;">Secure Transfers</h5>
                        <p class="text-white-50">Bank-level security with fraud protection</p>
                    </div>
                </div>
        
                <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="glass-card stat-card p-4 text-center">
                        <div style="width: 70px; height: 70px; background: linear-gradient(135deg, #4facfe, #00f2fe); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                            <i class="bi bi-lightning-charge" style="font-size: 35px; color: white;"></i>
                        </div>
                        <h5 class="gradient-text mt-3" style="font-weight: 700;">Instant Transfers</h5>
                        <p class="text-white-50">Send money globally in minutes, not days</p>
                    </div>
                </div>
            </div>
            
            <div class="mt-5" data-aos="fade-up" data-aos-delay="400">
                <a href="/register" class="btn-neon me-3" style="text-decoration: none; display: inline-block;">
                    <i class="bi bi-rocket-takeoff me-2"></i>Get Started
                </a>
                <a href="/login" class="btn-glass" style="text-decoration: none; display: inline-block;">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </a>
            </div>
        }
        
        <!-- Stats Section - Shows for everyone -->
        <div class="row mt-5 pt-4" data-aos="fade-up" data-aos-delay="500">
            <div class="col-12">
                <div class="glass-card p-4">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h3 class="gradient-text" style="font-size: 2rem; font-weight: 700;">10M+</h3>
                            <p class="text-white-50 small">Happy Customers</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="gradient-text" style="font-size: 2rem; font-weight: 700;">$50B+</h3>
                            <p class="text-white-50 small">Money Transferred</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="gradient-text" style="font-size: 2rem; font-weight: 700;">180+</h3>
                            <p class="text-white-50 small">Countries Covered</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="gradient-text" style="font-size: 2rem; font-weight: 700;">24/7</h3>
                            <p class="text-white-50 small">Customer Support</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 210, 255, 0.3);
        border-radius: 50px;
        padding: 12px 32px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
        cursor: pointer;
    }
    
        .btn-glass:hover {
            background: rgba(0, 210, 255, 0.2);
            border-color: #00d2ff;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 210, 255, 0.2);
            color: white;
        }
</style>

@code {
    private bool _isLoggedIn;
    private string _userName = "";
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isLoggedIn = await AuthService.IsAuthenticatedAsync();
            if (isLoggedIn)
            {
                var roles = await AuthService.GetCurrentUserRolesAsync();
                if (roles.Contains("Admin"))
                {
                    Navigation.NavigateTo("/admin/dashboard", true);
                    return;
                }
                else
                {
                    Navigation.NavigateTo("/dashboard", true);
                    return;
                }
            }
        
            _isLoggedIn = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Home page error: {ex.Message}");
            _isLoggedIn = false;
            StateHasChanged();
        }
    }
}
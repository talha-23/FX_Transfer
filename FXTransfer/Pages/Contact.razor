@page "/contact"
@attribute [Authorize]
@inject IToastService ToastService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container page-transition">
    <div class="row justify-content-center">
        <div class="col-lg-8" data-aos="fade-up">
            <div class="glass-card p-4">
                <div class="text-center mb-4">
                    <div class="float-animation" style="display: inline-block;">
                        <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                            <i class="bi bi-headset" style="font-size: 28px; color: white;"></i>
                        </div>
                    </div>
                    <h1 class="gradient-text">Contact Support</h1>
                    <p class="text-white-50">We're here to help 24/7</p>
                </div>

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success mb-3">@_successMessage</div>
                }

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: rgba(0,210,255,0.1); border-radius: 12px;">
                            <i class="bi bi-envelope" style="font-size: 30px; color: #00d2ff;"></i>
                            <h6 class="text-white mt-2">Email Us</h6>
                            <small class="text-white-50">support@fxtransfer.com</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: rgba(240,147,251,0.1); border-radius: 12px;">
                            <i class="bi bi-telephone" style="font-size: 30px; color: #f093fb;"></i>
                            <h6 class="text-white mt-2">Call Us</h6>
                            <small class="text-white-50">+1 (800) 123-4567</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 text-center" style="background: rgba(79,172,254,0.1); border-radius: 12px;">
                            <i class="bi bi-chat-dots" style="font-size: 30px; color: #4facfe;"></i>
                            <h6 class="text-white mt-2">Live Chat</h6>
                            <small class="text-white-50">Available 24/7</small>
                        </div>
                    </div>
                </div>

                <hr style="border-color: rgba(255,255,255,0.1); margin: 25px 0;">

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-white">Your Name</label>
                        <input type="text" class="form-control input-futuristic" @bind="_name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-white">Your Email</label>
                        <input type="email" class="form-control input-futuristic" @bind="_email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label text-white">Subject</label>
                        <input type="text" class="form-control input-futuristic" @bind="_subject" />
                    </div>
                    <div class="col-12">
                        <label class="form-label text-white">Message</label>
                        <textarea class="form-control input-futuristic" @bind="_message" rows="5" placeholder="Describe your issue..."></textarea>
                    </div>
                    <div class="col-12">
                        <button class="btn-neon w-100" @onclick="SendMessage">
                            <i class="bi bi-send me-2"></i>Send Message
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _name = "";
    private string _email = "";
    private string _subject = "";
    private string _message = "";
    private string _successMessage = "";
    
    protected override async Task OnInitializedAsync()
    {
        _name = await AuthService.GetCurrentUserFullNameAsync() ?? "";
        _email = await AuthService.GetCurrentUserEmailAsync() ?? "";
    }
    
    private async Task SendMessage()
    {
        if (string.IsNullOrEmpty(_subject) || string.IsNullOrEmpty(_message))
        {
            ToastService.ShowError("Please fill all fields");
            return;
        }
        
        _successMessage = "Thank you for contacting us! We'll respond within 24 hours.";
        
        await Task.Delay(2000);
        _subject = "";
        _message = "";
        StateHasChanged();
    }
}
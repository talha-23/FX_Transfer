@page "/liverates"
@attribute [Authorize]
@inject ICurrencyRateService RateService
@inject IToastService ToastService
@inject NavigationManager Navigation

<div class="container page-transition">
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-card p-4 text-center">
                <div class="float-animation" style="display: inline-block;">
                    <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                        <i class="bi bi-graph-up" style="font-size: 28px; color: white;"></i>
                    </div>
                </div>
                <h1 class="gradient-text">Live Exchange Rates</h1>
                <p class="text-white-50">Real-time currency rates with trend analysis</p>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <span class="badge" style="background: rgba(0,210,255,0.2); color: #00d2ff;">
                        <i class="bi bi-cloud-check me-1"></i>Live from API
                    </span>
                    <span class="badge" style="background: rgba(0,210,255,0.2); color: #00d2ff;">
                        <i class="bi bi-arrow-repeat me-1"></i>Auto-refresh: 30s
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="row mb-4">
        <div class="col-md-6 mx-auto">
            <div class="glass-card p-3">
                <div class="position-relative">
                    <i class="bi bi-search" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #00d2ff;"></i>
                    <input type="text" class="form-control input-futuristic" @bind="_searchTerm" @bind:event="oninput" 
                           placeholder="Search currency by name or code (e.g., Euro, PKR, Dollar)..." 
                           style="padding-left: 45px;" />
                </div>
            </div>
        </div>
    </div>

    <!-- Currency Cards Grid -->
    <div class="row g-4">
        @foreach (var currency in FilteredCurrencies)
        {
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="@(currency.Id * 50)">
                <div class="glass-card currency-card p-3" style="transition: all 0.3s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center">
                            <span class="fs-1 me-3">@GetFlagEmoji(currency.Code)</span>
                            <div>
                                <h3 class="text-white mb-0">@currency.Code</h3>
                                <small class="text-white-50">@currency.Name</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-info fw-bold fs-4">@currency.Rate.ToString("F4")</div>
                            <small class="text-white-50">USD → @currency.Code</small>
                        </div>
                    </div>
                    
                    <!-- Mini Trend Graph (CSS Animation) -->
                    <div class="trend-graph mb-2" style="height: 40px; display: flex; align-items: flex-end; gap: 3px; margin: 10px 0;">
                        @for (int i = 0; i < 20; i++)
                        {
                            var height = GetRandomHeight(currency.Code, i);
                            <div class="trend-bar" style="height: @height; width: 100%; background: linear-gradient(180deg, #00d2ff, #3a7bd5); border-radius: 3px; animation: pulse 1s ease infinite; animation-delay: @(i * 0.05)s;"></div>
                        }
                    </div>
                    
                    <!-- Trend Indicator -->
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div>
                            @if (currency.Trend == "up")
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-arrow-up"></i> ▲ @currency.TrendPercent%
                                </span>
                            }
                            else if (currency.Trend == "down")
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-arrow-down"></i> ▼ @currency.TrendPercent%
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-dash"></i> Stable
                                </span>
                            }
                        </div>
                        <button class="btn btn-sm btn-outline-info" @onclick="() => SetAsTargetCurrency(currency.Code)" style="border-radius: 20px;">
                            <i class="bi bi-arrow-left-right"></i> Use
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Refresh Button -->
    <div class="row mt-5">
        <div class="col-12 text-center">
            <button class="btn-neon" @onclick="RefreshRates" disabled="@_isRefreshing">
                @if (_isRefreshing)
                {
                    <span class="spinner-css me-2"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <span><i class="bi bi-arrow-repeat me-2"></i>Refresh Rates</span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    .currency-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .currency-card:hover {
        transform: translateY(-8px);
        border-color: #00d2ff;
        box-shadow: 0 10px 30px rgba(0, 210, 255, 0.2);
    }
    
    .trend-bar {
        transition: height 0.3s ease;
    }
    
    @@keyframes pulse {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }
    
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .currency-card {
        animation: slideIn 0.5s ease forwards;
    }
</style>

@code {
    private List<CurrencyData> _currencies = new();
    private List<CurrencyData> FilteredCurrencies => string.IsNullOrWhiteSpace(_searchTerm) 
        ? _currencies 
        : _currencies.Where(c => 
            c.Code.Contains(_searchTerm.ToUpper()) || 
            c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
          .ToList();
    
    private string _searchTerm = "";
    private bool _isRefreshing = false;
    private Random _random = new Random();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadRates();
        
        // Auto refresh every 30 seconds
        var timer = new System.Timers.Timer(30000);
        timer.Elapsed += async (sender, e) => await RefreshRates();
        timer.Start();
    }
    
    private async Task LoadRates()
    {
        try
        {
            var rates = await RateService.GetRatesAsync("USD");
            
            var allCurrencies = new List<(string Code, string Name)>
            {
                ("EUR", "Euro"),
                ("GBP", "British Pound"),
                ("PKR", "Pakistani Rupee"),
                ("AED", "UAE Dirham"),
                ("SAR", "Saudi Riyal"),
                ("CAD", "Canadian Dollar"),
                ("AUD", "Australian Dollar"),
                ("JPY", "Japanese Yen"),
                ("INR", "Indian Rupee"),
                ("CHF", "Swiss Franc"),
                ("CNY", "Chinese Yuan"),
                ("NZD", "New Zealand Dollar"),
                ("SGD", "Singapore Dollar"),
                ("MYR", "Malaysian Ringgit"),
                ("THB", "Thai Baht")
            };
            
            var id = 1;
            _currencies = allCurrencies
                .Where(c => rates.ContainsKey(c.Code))
                .Select(c => new CurrencyData
                {
                    Id = id++,
                    Code = c.Code,
                    Name = c.Name,
                    Rate = rates[c.Code],
                    Trend = GetRandomTrend(),
                    TrendPercent = _random.Next(1, 15)
                })
                .ToList();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to load rates");
        }
    }
    
    private string GetRandomTrend()
    {
        var trends = new[] { "up", "down", "stable" };
        return trends[_random.Next(0, 3)];
    }
    
    private int GetRandomHeight(string currencyCode, int index)
    {
        // Create predictable but varying heights based on currency code and index
        var seed = (currencyCode.GetHashCode() + index) % 100;
        return 15 + (seed % 25);
    }
    
    private string GetFlagEmoji(string currencyCode)
    {
        return currencyCode switch
        {
            "USD" => "🇺🇸",
            "EUR" => "🇪🇺",
            "GBP" => "🇬🇧",
            "PKR" => "🇵🇰",
            "AED" => "🇦🇪",
            "SAR" => "🇸🇦",
            "CAD" => "🇨🇦",
            "AUD" => "🇦🇺",
            "JPY" => "🇯🇵",
            "INR" => "🇮🇳",
            "CHF" => "🇨🇭",
            "CNY" => "🇨🇳",
            "NZD" => "🇳🇿",
            "SGD" => "🇸🇬",
            "MYR" => "🇲🇾",
            "THB" => "🇹🇭",
            _ => "🌍"
        };
    }
    
    private async Task RefreshRates()
    {
        _isRefreshing = true;
        StateHasChanged();
        await LoadRates();
        ToastService.ShowSuccess("Exchange rates refreshed!");
        _isRefreshing = false;
        StateHasChanged();
    }
    
    private void SetAsTargetCurrency(string currencyCode)
    {
        Navigation.NavigateTo($"/exchange?to={currencyCode}");
    }
    
    private class CurrencyData
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public decimal Rate { get; set; }
        public string Trend { get; set; } = "up";
        public int TrendPercent { get; set; }
    }
}
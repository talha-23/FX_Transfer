@page "/dashboard"
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container page-transition">
    <!-- Hero Welcome Section -->
    <div class="row mb-5" data-aos="fade-up" data-aos-duration="800">
        <div class="col-12">
            <div class="glass-card p-5 text-center">
                <div class="float-animation" style="display: inline-block;">
                    <div style="width: 100px; height: 100px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                        <i class="bi bi-emoji-smile" style="font-size: 50px; color: white;"></i>
                    </div>
                </div>
                <h1 class="gradient-text" style="font-size: 3rem; font-weight: 800; margin-bottom: 10px;">
                    Welcome back, @_userName!
                </h1>
                <p class="text-white-50" style="font-size: 1.1rem;">Here's what's happening with your account today</p>
                <div class="mt-3">
                    <span class="badge" style="background: rgba(0,210,255,0.2); color: #00d2ff; padding: 8px 16px; border-radius: 20px;">
                        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="glass-card stat-card p-4" data-aos="fade-up" data-aos-delay="100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-white-50 small mb-1">Total Balance</p>
                        <h2 class="text-white mb-0" style="font-size: 2rem;">$@_totalBalance.ToString("N2")</h2>
                        <small class="text-success">↑ +12.5% from last month</small>
                    </div>
                    <div style="width: 50px; height: 50px; background: rgba(0,210,255,0.2); border-radius: 15px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-wallet2" style="font-size: 25px; color: #00d2ff;"></i>
                    </div>
                </div>
                <div class="progress mt-3" style="background: rgba(255,255,255,0.1); height: 6px;">
                    <div class="progress-bar progress-bar-animated" style="width: 75%; border-radius: 10px;"></div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <div class="glass-card stat-card p-4" data-aos="fade-up" data-aos-delay="200">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-white-50 small mb-1">Total Transfers</p>
                        <h2 class="text-white mb-0" style="font-size: 2rem;">@_totalTransfers</h2>
                        <small class="text-info">Completed successfully</small>
                    </div>
                    <div style="width: 50px; height: 50px; background: rgba(240,147,251,0.2); border-radius: 15px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-arrow-left-right" style="font-size: 25px; color: #f093fb;"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <div class="glass-card stat-card p-4" data-aos="fade-up" data-aos-delay="300">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-white-50 small mb-1">Account Status</p>
                        <h2 class="text-white mb-0" style="font-size: 1.5rem;">@(_isPremium ? "🌟 Premium" : "Standard")</h2>
                        <small class="text-warning">@(_isPremium ? "All features unlocked" : "Upgrade to Premium")</small>
                    </div>
                    <div style="width: 50px; height: 50px; background: rgba(79,172,254,0.2); border-radius: 15px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-star-fill" style="font-size: 25px; color: #4facfe;"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-3">
            <div class="glass-card stat-card p-4" data-aos="fade-up" data-aos-delay="400">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-white-50 small mb-1">Exchange Rate</p>
                        <h2 class="text-white mb-0" style="font-size: 1.5rem;">USD/EUR</h2>
                        <h3 class="text-white mb-0" style="font-size: 1.8rem;">0.92</h3>
                    </div>
                    <div style="width: 50px; height: 50px; background: rgba(0,210,255,0.2); border-radius: 15px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-graph-up" style="font-size: 25px; color: #00d2ff;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Activity Row -->
    <div class="row g-4">
        <!-- Quick Actions Column -->
        <div class="col-lg-5" data-aos="fade-right" data-aos-delay="500">
            <div class="glass-card p-4">
                <h4 class="gradient-text mb-4">
                    <i class="bi bi-lightning-charge me-2"></i>Quick Actions
                </h4>
                <div class="d-grid gap-3">
                    <button class="btn-neon w-100" @onclick="GoToExchange" style="text-align: center;">
                        <i class="bi bi-currency-exchange me-2"></i>Send Money
                    </button>
                    <button class="btn btn-outline-info w-100" @onclick="GoToWallet" style="border-radius: 50px; padding: 12px;">
                        <i class="bi bi-wallet2 me-2"></i>Manage Wallet
                    </button>
                    <button class="btn btn-outline-primary w-100" @onclick="GoToTransfers" style="border-radius: 50px; padding: 12px;">
                        <i class="bi bi-clock-history me-2"></i>Transaction History
                    </button>
                    <button class="btn btn-outline-danger w-100" @onclick="LogoutAsync" style="border-radius: 50px; padding: 12px;">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </div>
                
                @if (!_isPremium)
                {
                    <div class="mt-4 p-3" style="background: linear-gradient(135deg, rgba(240,147,251,0.1), rgba(0,210,255,0.1)); border-radius: 16px;">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-gem" style="font-size: 30px; color: #f093fb;"></i>
                            <div class="ms-3">
                                <small class="text-white-50">Upgrade to Premium</small>
                                <h6 class="text-white mb-0">Get 50% off on fees!</h6>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <!-- Recent Activity Column -->
        <div class="col-lg-7" data-aos="fade-left" data-aos-delay="600">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="gradient-text mb-0">
                        <i class="bi bi-activity me-2"></i>Recent Activity
                    </h4>
                    <button class="btn btn-sm btn-outline-info" @onclick="GoToTransfers" style="border-radius: 20px;">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
                
                @if (_recentTransfers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <thead>
                                <tr>
                                    <th class="text-white-50 small">Date</th>
                                    <th class="text-white-50 small">From/To</th>
                                    <th class="text-white-50 small">Amount</th>
                                    <th class="text-white-50 small">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transfer in _recentTransfers)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <td class="text-white-50">@transfer.Date</td>
                                        <td class="text-white">@transfer.From → @transfer.To</td>
                                        <td class="text-white">@transfer.Amount</td>
                                        <td>
                                            <span class="badge" style="background: rgba(0,210,255,0.2); color: #00d2ff;">
                                                Completed
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 60px; color: rgba(255,255,255,0.2);"></i>
                        <p class="text-white-50 mt-3">No recent transactions</p>
                        <button class="btn-neon mt-2" @onclick="GoToExchange" style="padding: 8px 24px;">
                            Make your first transfer
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Currency Rates Section -->
    <div class="row mt-4" data-aos="fade-up" data-aos-delay="700">
        <div class="col-12">
            <div class="glass-card p-4">
                <h4 class="gradient-text mb-4">
                    <i class="bi bi-currency-exchange me-2"></i>Live Exchange Rates
                </h4>
                <div class="row g-3">
                    @foreach (var rate in _exchangeRates)
                    {
                        <div class="col-md-3">
                            <div class="p-3" style="background: rgba(255,255,255,0.05); border-radius: 12px;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-white mb-0">@rate.Currency</h6>
                                        <small class="text-white-50">@rate.Code</small>
                                    </div>
                                    <h5 class="text-white mb-0">@rate.Rate</h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _userName = "";
    private decimal _totalBalance = 12500.50m;
    private int _totalTransfers = 23;
    private bool _isPremium = false;
    
    private List<RecentTransfer> _recentTransfers = new();
    private List<ExchangeRate> _exchangeRates = new();
    
    protected override async Task OnInitializedAsync()
    {
        _userName = await AuthService.GetCurrentUserFullNameAsync() ?? "User";
        var roles = await AuthService.GetCurrentUserRolesAsync();
        _isPremium = roles.Contains("Premium");
        
        // Sample data - Replace with real data from your service
        LoadSampleData();
    }
    
    private void LoadSampleData()
    {
        _recentTransfers = new List<RecentTransfer>
        {
            new() { Date = "2024-01-15", From = "USD", To = "EUR", Amount = "$1,000.00" },
            new() { Date = "2024-01-10", From = "EUR", To = "GBP", Amount = "€500.00" },
            new() { Date = "2024-01-05", From = "USD", To = "PKR", Amount = "$2,000.00" },
            new() { Date = "2024-01-01", From = "GBP", To = "USD", Amount = "£750.00" }
        };
        
        _exchangeRates = new List<ExchangeRate>
        {
            new() { Code = "EUR", Currency = "Euro", Rate = "0.92" },
            new() { Code = "GBP", Currency = "British Pound", Rate = "0.79" },
            new() { Code = "PKR", Currency = "Pakistani Rupee", Rate = "278.50" },
            new() { Code = "AED", Currency = "Dirham", Rate = "3.67" }
        };
    }
    
    private void GoToExchange() => Navigation.NavigateTo("/exchange");
    private void GoToWallet() => Navigation.NavigateTo("/wallet");
    private void GoToTransfers() => Navigation.NavigateTo("/transfers");
    
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
    
    private class RecentTransfer
    {
        public string Date { get; set; } = "";
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string Amount { get; set; } = "";
    }
    
    private class ExchangeRate
    {
        public string Code { get; set; } = "";
        public string Currency { get; set; } = "";
        public string Rate { get; set; } = "";
    }
}
@page "/dashboard"
@attribute [Authorize]
@inject IAuthService AuthService
@inject IWalletService WalletService
@inject IToastService ToastService
@inject NavigationManager Navigation
@using FXTransfer.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<div class="container page-transition">
    <!-- Welcome Section -->
    <div class="row mb-4" data-aos="fade-up">
        <div class="col-12">
            <div class="glass-card p-4 text-center">
                <div class="float-animation" style="display: inline-block;">
                    <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                        <i class="bi bi-emoji-smile" style="font-size: 40px; color: white;"></i>
                    </div>
                </div>
                <h1 class="gradient-text mb-2">Welcome back, @_userName!</h1>
                <p class="text-white-50 mb-0">Here's your financial overview</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="glass-card stat-card p-4 text-center">
                <div style="width: 60px; height: 60px; background: rgba(0,210,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                    <i class="bi bi-wallet2" style="font-size: 28px; color: #00d2ff;"></i>
                </div>
                <h2 class="text-white mb-1">$@_totalBalance.ToString("N2")</h2>
                <p class="text-white-50 small mb-0">Total Balance</p>
            </div>
        </div>
        
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="glass-card stat-card p-4 text-center">
                <div style="width: 60px; height: 60px; background: rgba(240,147,251,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                    <i class="bi bi-arrow-left-right" style="font-size: 28px; color: #f093fb;"></i>
                </div>
                <h2 class="text-white mb-1">@_totalTransfers</h2>
                <p class="text-white-50 small mb-0">Total Transfers</p>
            </div>
        </div>
        
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="glass-card stat-card p-4 text-center">
                <div style="width: 60px; height: 60px; background: rgba(79,172,254,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                    <i class="bi bi-star-fill" style="font-size: 28px; color: #4facfe;"></i>
                </div>
                <h2 class="text-white mb-1" style="font-size: 1.5rem;">@(_isPremium ? "✨ Premium" : "Standard")</h2>
                <p class="text-white-50 small mb-0">@(_isPremium ? "50% off fees" : "Upgrade to save")</p>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row g-4">
        <div class="col-md-6" data-aos="fade-up" data-aos-delay="400">
            <div class="glass-card p-4 text-center">
                <i class="bi bi-currency-exchange" style="font-size: 48px; color: #00d2ff;"></i>
                <h4 class="text-white mt-3">Send Money</h4>
                <p class="text-white-50">Transfer funds internationally</p>
                <button class="btn-neon" @onclick="GoToExchange">
                    <i class="bi bi-send me-2"></i>Start Transfer
                </button>
            </div>
        </div>
        
        <div class="col-md-6" data-aos="fade-up" data-aos-delay="500">
            <div class="glass-card p-4 text-center">
                <i class="bi bi-graph-up" style="font-size: 48px; color: #f093fb;"></i>
                <h4 class="text-white mt-3">Live Exchange Rates</h4>
                <p class="text-white-50">View real-time currency rates with trends</p>
                <button class="btn btn-outline-info" @onclick="GoToLiveRates" style="border-radius: 50px; padding: 10px 24px;">
                    <i class="bi bi-eye me-2"></i>View Rates →
                </button>
            </div>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="glass-card p-4">
                <h4 class="gradient-text mb-3">Recent Activity</h4>
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead>
                            <tr style="border-bottom: 2px solid rgba(0,210,255,0.2);">
                                <th class="text-info">Date</th>
                                <th class="text-info">Type</th>
                                <th class="text-info">From/To</th>
                                <th class="text-info">Amount</th>
                                <th class="text-info">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_recentTransfers.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <i class="bi bi-inbox" style="font-size: 48px; color: rgba(255,255,255,0.2);"></i>
                                        <p class="text-white-50 mt-2">No recent transactions</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var transaction in _recentTransfers)
                                {
                                    <tr style="border-bottom: 1px solid rgba(0,210,255,0.1);">
                                        <td class="text-success-emphasis fw-semibold" style="color: black !important;">@transaction.Date</td>
                                        <td>
                                            @if (transaction.Type == "Exchange")
                                            {
                                                <span class="badge" style="background: rgba(0,210,255,0.2); color: #00d2ff;">🔄 Exchange</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(240,147,251,0.2); color: #f093fb;">📤 Transfer</span>
                                            }
                                        </td>
                                        <td class="fw-semibold" style="color: #0a3622 !important;">@transaction.From → @transaction.To</td>
                                        <td class="text-info fw-bold">@transaction.Amount</td>
                                        <td>
                                            <span class="badge bg-success">✅ @transaction.Status</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-center mt-3">
                    <a href="/transfers" class="btn btn-sm btn-outline-info" style="border-radius: 20px;">
                        View All Transactions →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _userName = "";
    private decimal _totalBalance = 0;
    private int _totalTransfers = 0;
    private bool _isPremium = false;
    private string _userId = "";
    private List<RecentTransfer> _recentTransfers = new();

    
    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        await LoadWalletData();
        await LoadRecentTransactions();
    }
    
    private async Task LoadUserData()
    {
        _userName = await AuthService.GetCurrentUserFullNameAsync() ?? "User";
        _userId = await AuthService.GetCurrentUserIdAsync() ?? "";
        var roles = await AuthService.GetCurrentUserRolesAsync();
        _isPremium = roles.Contains("Premium");
    }
    
    private async Task LoadWalletData()
    {
        var wallets = await WalletService.GetUserWalletsAsync(_userId);
        _totalBalance = wallets.Where(w => w.CurrencyCode == "USD").Sum(w => w.Balance);
        if (_totalBalance == 0 && wallets.Any())
        {
            _totalBalance = wallets.First().Balance;
        }
    }
    private class RecentTransfer
    {
        public string Date { get; set; } = "";
        public string Type { get; set; } = "";
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string Amount { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private async Task LoadRecentTransactions()
    {
        var transfers = await DbContext.Transfers
            .Where(t => t.UserId == _userId)
            .OrderByDescending(t => t.CreatedAt)
            .Take(5)
            .ToListAsync();
    
        _recentTransfers = transfers.Select(t => new RecentTransfer
        {
            Date = t.CreatedAt.ToString("MMM dd, yyyy"),
            Type = t.RecipientName == "Self Transfer" ? "Exchange" : "Transfer",
            From = t.FromCurrency,
            To = t.ToCurrency,
            Amount = $"{t.Amount:F2} {t.FromCurrency}",
            Status = t.Status
        }).ToList();
    
        StateHasChanged();
    }
    
    private void GoToExchange() => Navigation.NavigateTo("/exchange");
    private void GoToLiveRates() => Navigation.NavigateTo("/liverates");
    private void GoToTransfers() => Navigation.NavigateTo("/transfers");
    
}
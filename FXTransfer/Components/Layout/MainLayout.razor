@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<div class="page-transition">
    <!-- Top Navigation Bar -->
    <div class="top-row px-4" style="background: rgba(15, 25, 35, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0,210,255,0.2);">
        <div class="ms-auto d-flex align-items-center">
            <!-- Notification Bell -->
            <NotificationBell />
            
            @if (_isLoggedIn)
            {
                <span class="text-white-50 me-3 ms-3">
                    <i class="bi bi-person-circle me-1"></i> @_userFullName
                </span>
                <a href="/logout" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            }
            else
            {
                <a href="/login" class="btn btn-sm btn-outline-info me-2">Login</a>
                <a href="/register" class="btn btn-sm btn-neon">Register</a>
            }
        </div>
    </div>

    <!-- Layout with Sidebar and Main Content -->
    <div class="app-layout">
        <!-- Sidebar CSS -->
        <style>
                    .app-layout {
                        display: flex;
                        min-height: calc(100vh - 50px);
                    }
            
                    .sidebar {
                        width: 280px;
                        position: fixed;
                        top: 50px;
                        bottom: 0;
                        left: 0;
                        z-index: 100;
                        background: rgba(15, 25, 35, 0.95);
                        backdrop-filter: blur(10px);
                        border-right: 1px solid rgba(0, 210, 255, 0.2);
                        transition: transform 0.3s ease;
                    }
            
                    .main-content {
                        flex: 1;
                        margin-left: 280px;
                        min-height: calc(100vh - 50px);
                        transition: margin-left 0.3s ease;
                    }
            
                    .mobile-menu-toggle {
                        display: none;
                        position: fixed;
                        top: 60px;
                        left: 10px;
                        z-index: 101;
                        background: rgba(0, 210, 255, 0.2);
                        border: 1px solid rgba(0, 210, 255, 0.5);
                        border-radius: 8px;
                        padding: 8px 12px;
                        cursor: pointer;
                        color: white;
                    }
            
                    @@media (max-width: 768px) {
                        .sidebar {
                            transform: translateX(-100%);
                        }
                
                            .sidebar.open {
                                transform: translateX(0);
                            }
                
                        .main-content {
                            margin-left: 0;
                        }
                
                        .mobile-menu-toggle {
                            display: block;
                        }
                    }
            
                    .top-row {
                        position: sticky;
                        top: 0;
                        z-index: 102;
                        height: 50px;
                        display: flex;
                        align-items: center;
                    }
            
                    .btn-neon {
                        background: linear-gradient(135deg, #00d2ff, #3a7bd5);
                        border: none;
                        color: white;
                        padding: 5px 15px;
                        border-radius: 8px;
                        transition: all 0.3s ease;
                    }
            
                        .btn-neon:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 5px 15px rgba(0, 210, 255, 0.3);
                        }
            
                    .btn-outline-danger {
                        border-radius: 8px;
                    }
            
                    .btn-outline-info {
                        border-radius: 8px;
                    }
            
                    .text-white-50 {
                        color: rgba(255, 255, 255, 0.7) !important;
                    }
        </style>

        <!-- Mobile Menu Toggle Button -->
        <div class="mobile-menu-toggle" @onclick="ToggleSidebar">
            <i class="bi bi-list" style="font-size: 20px;"></i>
        </div>

        <!-- Sidebar with NavMenu -->
        <div class="sidebar @(_sidebarOpen ? "open" : "")">
            <NavMenu />
        </div>

        <!-- Main Content Area -->
        <div class="main-content">
            <main style="min-height: calc(100vh - 100px); padding: 1.5rem;">
                @Body
            </main>

            <!-- Footer -->
            <footer style="background: rgba(15, 25, 35, 0.8); backdrop-filter: blur(10px); border-top: 1px solid rgba(0, 210, 255, 0.2); padding: 1rem 0; margin-top: 2rem;">
                <div class="container text-center">
                    <p class="small text-white-50 mb-0">
                        <i class="bi bi-currency-exchange me-1"></i> FXTransfer - The Future of Currency Exchange
                    </p>
                    <p class="small text-white-50 mt-1 mb-0">
                        <i class="bi bi-shield-check me-1"></i> Secure & Fast | 24/7 Support
                    </p>
                    <p class="small text-white-50 mt-2 mb-0">
                        © 2026 All rights reserved | Powered by MT Technology
                    </p>
                </div>
            </footer>
        </div>
    </div>
</div>

@code {
    private bool _isLoggedIn;
    private bool _isSuspended;
    private bool _isAdmin;  // ADD THIS
    private string _userFullName = "";
    private bool _sidebarOpen = false;
    
    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }
    
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await LoadUserInfo();
            StateHasChanged();
        });
    }
    
    private async Task LoadUserInfo()
    {
        _isLoggedIn = await AuthService.IsAuthenticatedAsync();
        if (_isLoggedIn)
        {
            _userFullName = await AuthService.GetCurrentUserFullNameAsync() ?? "User";
            var email = await AuthService.GetCurrentUserEmailAsync() ?? "";
            // DIRECT EMAIL CHECK
            var roles = await AuthService.GetCurrentUserRolesAsync();
            _isSuspended = roles.Contains("Suspended");
        }
        else
        {
            _userFullName = "";
        }
        StateHasChanged();
    }
    
    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
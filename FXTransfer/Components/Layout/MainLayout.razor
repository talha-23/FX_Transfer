@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="page-transition">
    <!-- Futuristic Navbar -->
    <nav class="navbar navbar-expand-lg navbar-futuristic sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/" style="font-family: 'Space Grotesk', monospace;">
                <div class="d-flex align-items-center">
                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                        <i class="bi bi-currency-exchange" style="color: white;"></i>
                    </div>
                    <span class="gradient-text" style="font-size: 1.5rem; font-weight: 800;">FXTransfer</span>
                </div>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(0,210,255,0.5);">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (_isLoggedIn && !_isSuspended)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/dashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/exchange">
                                <i class="bi bi-currency-exchange"></i> Exchange
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/wallet">
                                <i class="bi bi-wallet2"></i> Wallet
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <div style="width: 35px; height: 35px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-person-fill" style="font-size: 16px;"></i>
                                </div>
                                <span class="ms-2">@_userFullName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" style="background: rgba(15,25,35,0.95); backdrop-filter: blur(10px); border: 1px solid rgba(0,210,255,0.3);">
                                <li><a class="dropdown-item text-white" href="/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                                <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    }
                    else if (!_isLoggedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn-neon" href="/register" style="color: white; padding: 8px 20px; text-decoration: none;">
                                Get Started
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main style="min-height: calc(100vh - 200px); position: relative; z-index: 1;">
        <div class="py-4">
            @Body
        </div>
    </main>

    <!-- Futuristic Footer -->
    <footer style="background: rgba(15,25,35,0.8); backdrop-filter: blur(10px); border-top: 1px solid rgba(0,210,255,0.2); padding: 2rem 0; margin-top: 3rem;">
        <div class="container text-center">
            <p class="mb-0 text-white-50">
                <i class="bi bi-currency-exchange"></i> FXTransfer - The Future of Currency Exchange
            </p>
            <p class="small text-white-50 mt-2">
                &copy; 2026 All rights reserved | Powered by MT Technology
            </p>
        </div>
    </footer>
</div>

@code {
    private bool _isLoggedIn;
    private bool _isSuspended;
    private string _userFullName = "";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }
    
    private async Task LoadUserInfo()
    {
        _isLoggedIn = await AuthService.IsAuthenticatedAsync();
        if (_isLoggedIn)
        {
            _userFullName = await AuthService.GetCurrentUserFullNameAsync() ?? "User";
            var roles = await AuthService.GetCurrentUserRolesAsync();
            _isSuspended = roles.Contains("Suspended");
        }
        StateHasChanged();
    }
}
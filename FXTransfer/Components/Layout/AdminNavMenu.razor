@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark" style="background: linear-gradient(135deg, #0f0c29, #1a1a3e);">
    <div class="container-fluid">
        <a class="navbar-brand" href="/admin/dashboard">
            <div class="d-flex align-items-center">
                <div style="width: 35px; height: 35px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                    <i class="bi bi-shield-lock" style="color: white; font-size: 18px;"></i>
                </div>
                <span style="font-weight: 700;">Admin Panel</span>
            </div>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Admin Main Menu -->
        <div class="nav-item px-3 mt-2">
            <div class="text-white-50 small px-3 mb-2" style="letter-spacing: 2px;">MAIN</div>
            <NavLink class="nav-link" href="/admin/dashboard" Match="NavLinkMatch.Prefix">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </NavLink>
            <NavLink class="nav-link" href="/admin/users">
                <i class="bi bi-people me-2"></i> User Management
            </NavLink>
            <NavLink class="nav-link" href="/admin/transactions">
                <i class="bi bi-arrow-left-right me-2"></i> Transactions
            </NavLink>
            <NavLink class="nav-link" href="/admin/fees">
                <i class="bi bi-percent me-2"></i> Fee Configuration
            </NavLink>
            <NavLink class="nav-link" href="/admin/logs">
                <i class="bi bi-file-text me-2"></i> System Logs
            </NavLink>
            <NavLink class="nav-link" href="/admin/analytics">
                <i class="bi bi-graph-up me-2"></i> Analytics
            </NavLink>
        </div>

        <!-- Quick Actions -->
        <div class="nav-item px-3 mt-4">
            <div class="text-white-50 small px-3 mb-2" style="letter-spacing: 2px;">QUICK ACTIONS</div>
            <NavLink class="nav-link" href="/dashboard">
                <i class="bi bi-box-arrow-left me-2"></i> Back to User Panel
            </NavLink>
            <NavLink class="nav-link" href="/exchange">
                <i class="bi bi-currency-exchange me-2"></i> Make a Transfer
            </NavLink>
        </div>

        <!-- Account -->
        <div class="nav-item px-3 mt-4">
            <div class="text-white-50 small px-3 mb-2" style="letter-spacing: 2px;">ACCOUNT</div>
            <div class="nav-link text-white-50">
                <i class="bi bi-person-circle me-2"></i> @_adminName
            </div>
            <NavLink class="nav-link text-danger" href="/logout">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </NavLink>
        </div>

        <!-- Footer -->
        <div class="nav-item px-3 mt-4">
            <small class="text-white-50 d-block text-center">
                <i class="bi bi-shield-check me-1"></i> Admin Access Only
            </small>
        </div>
    </nav>
</div>

<style>
    .navbar-toggler {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(0, 210, 255, 0.3);
    }

    .top-row {
        height: 3.5rem;
        background: rgba(15, 25, 35, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0, 210, 255, 0.2);
    }

    .navbar-brand {
        font-size: 1.1rem;
    }

    .nav-item {
        font-size: 0.9rem;
        padding-bottom: 0.5rem;
    }

        .nav-item ::deep a {
            color: #d7d7d7;
            border-radius: 8px;
            height: 2.8rem;
            display: flex;
            align-items: center;
            line-height: 2.8rem;
            transition: all 0.2s ease;
        }

            .nav-item ::deep a.active {
                background: linear-gradient(90deg, rgba(0, 210, 255, 0.15), rgba(240, 147, 251, 0.15));
                color: #00d2ff;
                border-left: 3px solid #00d2ff;
            }

            .nav-item ::deep a:hover {
                background: rgba(0, 210, 255, 0.1);
                color: #00d2ff;
                transform: translateX(5px);
            }

    .text-white-50 {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    @@media (min-width: 641px) {
        .navbar-toggler {
            display: none;
        }

        .collapse {
            display: block;
        }
        
        .nav-scrollable {
            height: calc(100vh - 3.5rem);
            overflow-y: auto;
        }
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private string _adminName = "";
    
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _adminName = await AuthService.GetCurrentUserFullNameAsync() ?? "Admin";
        StateHasChanged();
    }
}
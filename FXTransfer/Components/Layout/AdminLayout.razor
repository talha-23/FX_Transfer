@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Admin Sidebar -->
        <div class="col-auto" style="width: 280px; min-height: 100vh; background: rgba(10, 20, 30, 0.98); backdrop-filter: blur(15px); border-right: 1px solid rgba(0,210,255,0.3); position: fixed; top: 0; left: 0; bottom: 0; z-index: 1000; display: flex; flex-direction: column;">
            
            <!-- Scrollable Sidebar Content -->
            <div style="flex: 1; overflow-y: auto; overflow-x: hidden;">
                <div class="p-3">
                    <!-- Logo Section -->
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom" style="border-color: rgba(0,210,255,0.2) !important;">
                        <div style="width: 45px; height: 45px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 12px; box-shadow: 0 0 20px rgba(0,210,255,0.3);">
                            <i class="bi bi-shield-lock" style="color: white; font-size: 22px;"></i>
                        </div>
                        <div>
                            <span class="gradient-text fw-bold" style="font-size: 1.3rem;">Admin Panel</span>
                            <small class="text-white-50 d-block">FXTransfer Control Center</small>
                        </div>
                    </div>
                    
                    <!-- Admin Name Section -->
                    <div class="mb-4 p-2" style="background: rgba(0,210,255,0.1); border-radius: 12px;">
                        <div class="d-flex align-items-center">
                            <div style="width: 35px; height: 35px; background: linear-gradient(135deg, #00d2ff, #f093fb); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-person-fill" style="color: white; font-size: 18px;"></i>
                            </div>
                            <div class="ms-2">
                                <small class="text-white-50 d-block">Logged in as</small>
                                <span class="text-white fw-bold" style="font-size: 0.85rem;">@_adminName</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Main Navigation -->
                    <div class="mb-3">
                        <div class="text-white-50 small mb-2" style="letter-spacing: 2px; font-size: 0.7rem;">
                            <i class="bi bi-grid me-1"></i> MAIN MENU
                        </div>
                        <ul class="nav flex-column">
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/dashboard" Match="NavLinkMatch.Prefix">
                                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                    <span class="badge ms-2" style="background: rgba(0,210,255,0.2); color: #00d2ff; font-size: 0.6rem;">Home</span>
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/users">
                                    <i class="bi bi-people me-2"></i> User Management
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/transactions">
                                    <i class="bi bi-arrow-left-right me-2"></i> Transactions
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/fees">
                                    <i class="bi bi-percent me-2"></i> Fee Configuration
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/logs">
                                    <i class="bi bi-file-text me-2"></i> System Logs
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <NavLink class="nav-link text-white" href="/admin/analytics">
                                    <i class="bi bi-graph-up me-2"></i> Analytics
                                </NavLink>
                            </li>
                            <li class="nav-item mb-1">
                                <a class="nav-link text-white" href="/liverates">
                                    <i class="bi bi-graph-up me-2"></i> View Live Rates
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                    
                    
                    <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;" />
                    
                    <!-- Version Info -->
                    <div class="text-center mb-3">
                        <small class="text-white-50 d-block">
                            <i class="bi bi-shield-check me-1"></i> Secure Admin Access
                        </small>
                        <small class="text-white-50 d-block mt-1" style="font-size: 0.65rem;">
                            FXTransfer v2.0 | Admin Mode
                        </small>
                    </div>
                </div>
            </div>
            
            <!-- Logout Button - Fixed at Bottom -->
            <div style="border-top: 1px solid rgba(0,210,255,0.2); padding: 15px; background: rgba(10, 20, 30, 0.98);">
                <a href="/logout" class="btn btn-danger w-100" style="border-radius: 12px; padding: 12px; background: linear-gradient(135deg, #dc3545, #c82333); border: none; transition: all 0.3s ease;">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
                <div class="text-center mt-2">
                    <small class="text-white-50" style="font-size: 0.65rem;">
                        <i class="bi bi-clock me-1"></i> Last login: @_lastLogin
                    </small>
                </div>
            </div>
        </div>
        
        <!-- Main Content Area -->
        <div style="margin-left: 280px; flex: 1; min-height: 100vh; background: linear-gradient(135deg, #0f0c29 0%, #1a1a3e 50%, #24243e 100%);">
            <!-- Top Bar -->
            <div style="background: rgba(10, 20, 30, 0.8); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(0,210,255,0.2); padding: 12px 24px; display: flex; justify-content: flex-end; align-items: center; gap: 15px; position: sticky; top: 0; z-index: 999;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-bell text-info me-2"></i>
                    <small class="text-white-50">Admin Mode Active</small>
                </div>
                <div class="vr text-white-50"></div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-check text-success me-2"></i>
                    <small class="text-white-50">Secure Connection</small>
                </div>
                <div class="vr text-white-50"></div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-clock text-info me-2"></i>
                    <small class="text-white-50">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</small>
                </div>
                <div class="vr text-white-50"></div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-globe text-info me-2"></i>
                    <small class="text-white-50">Admin: @_adminShortName</small>
                </div>
            </div>
            
            <!-- Page Content -->
            <main class="p-4">
                @Body
            </main>
        </div>
    </div>
</div>

<style>
    /* Custom Scrollbar for Sidebar */
    ::-webkit-scrollbar {
        width: 6px;
    }
    
    ::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }
    
    ::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, #00d2ff, #f093fb);
        border-radius: 10px;
    }
    
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #f093fb, #00d2ff);
        }
    
    /* Navigation Links */
    .nav-link {
        padding: 10px 15px;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }
    
        .nav-link i {
            font-size: 1.1rem;
            width: 24px;
        }
    
        .nav-link:hover {
            background: rgba(0, 210, 255, 0.15);
            transform: translateX(5px);
            color: #00d2ff !important;
        }
    
        .nav-link.active {
            background: linear-gradient(90deg, rgba(0, 210, 255, 0.2), rgba(240, 147, 251, 0.1));
            color: #00d2ff !important;
            border-left: 3px solid #00d2ff;
        }
    
    /* Gradient Text */
    .gradient-text {
        background: linear-gradient(135deg, #00d2ff, #f093fb);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    /* Logout Button Hover Effect */
    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(220, 53, 69, 0.4);
    }
    
    /* Responsive */
    @@media (max-width: 768px) {
        .col-auto {
            width: 80px !important;
        }
        
            .col-auto .d-flex .ms-2,
            .col-auto .gradient-text,
            .col-auto .text-white-50.d-block,
            .col-auto .badge,
            .col-auto .nav-link span:not(i),
            .col-auto .vr,
            .col-auto .text-center.mb-3,
            .col-auto .border-bottom span,
            .col-auto .ms-2,
            .btn-danger span {
                display: none !important;
            }
        
            .col-auto .nav-link {
                justify-content: center;
                padding: 12px 0;
            }
        
                .col-auto .nav-link i {
                    margin-right: 0 !important;
                    font-size: 1.3rem;
                }
        
            .col-auto .d-flex.align-items-center {
                justify-content: center;
            }
        
                .col-auto .d-flex.align-items-center div:first-child {
                    margin-right: 0 !important;
                }
        
        [style*="margin-left: 280px"] {
            margin-left: 80px !important;
        }
        
        .btn-danger {
            padding: 12px 0 !important;
        }
        
            .btn-danger i {
                margin-right: 0 !important;
                font-size: 1.2rem;
            }
    }
</style>

@code {
    private string _adminName = "";
    private string _adminShortName = "";
    private string _lastLogin = "";
    
    protected override async Task OnInitializedAsync()
    {
        _adminName = await AuthService.GetCurrentUserFullNameAsync() ?? "Administrator";
        _adminShortName = _adminName.Length > 15 ? _adminName.Substring(0, 15) + "..." : _adminName;
        _lastLogin = DateTime.Now.ToString("HH:mm");
        StateHasChanged();
    }
}
<style>
    .nav-scrollable {
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: thin;
    }
    
        /* Custom Scrollbar */
        .nav-scrollable::-webkit-scrollbar {
            width: 6px;
        }
    
        .nav-scrollable::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
    
        .nav-scrollable::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #00d2ff, #f093fb);
            border-radius: 5px;
        }
    
    .gradient-text {
        background: linear-gradient(135deg, #00d2ff, #f093fb);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .nav-item {
        margin-bottom: 0.35rem;
    }
    
    .nav-link {
        color: rgba(255, 255, 255, 0.85) !important;
        border-radius: 12px;
        padding: 0.85rem 1rem !important;
        transition: all 0.3s ease;
        font-size: 1rem !important;
        font-weight: 500;
    }
    
        .nav-link:hover {
            background: linear-gradient(90deg, rgba(0, 210, 255, 0.1), rgba(240, 147, 251, 0.05));
            color: #00d2ff !important;
            transform: translateX(5px);
        }
    
        .nav-link.active {
            background: linear-gradient(90deg, rgba(0, 210, 255, 0.15), rgba(240, 147, 251, 0.1));
            color: #00d2ff !important;
            border-left: 3px solid #00d2ff;
        }
    
        .nav-link i {
            width: 28px;
            font-size: 1.2rem;
        }
    
    .text-white-50 {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255, 255, 255, 0.5) !important;
    }
    
    .nav-divider {
        position: relative;
    }
    
    .user-status {
        transition: all 0.3s ease;
    }
    
        .user-status:hover {
            background: rgba(0, 210, 255, 0.2) !important;
        }
    
    .badge {
        font-size: 11px;
        padding: 4px 10px;
    }
</style>

@code {
    private bool _isLoggedIn;
    private bool _isAdmin;
    private bool _isSuspended;
    private bool _isPremium;
    private string _userEmail = "";
    private string _userId = "";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }
    
    private async Task LoadUserInfo()
    {
        try
        {
            _isLoggedIn = await AuthService.IsAuthenticatedAsync();
            if (_isLoggedIn)
            {
                _userEmail = await AuthService.GetCurrentUserEmailAsync() ?? "";
                _userId = await AuthService.GetCurrentUserIdAsync() ?? "";
            
                // DIRECT EMAIL CHECK - NO ROLE DETECTION NEEDED
                _isAdmin = _userEmail == "admin@fxtransfer.com";
            
                if (!string.IsNullOrEmpty(_userId))
                {
                    var user = await UserManager.FindByIdAsync(_userId);
                    if (user != null)
                    {
                        _isPremium = user.IsPremium;
                    }
                }
            }
            else
            {
                _isAdmin = false;
                _isPremium = false;
                _isSuspended = false;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user info: {ex.Message}");
        }
    }
}